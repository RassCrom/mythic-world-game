# Copy this file to client/.env.production and set the URL your Worker deploy
# printed. Vite reads .env.production automatically during `npm run build`, so
# you never have to remember the shell syntax for an inline env var.
#
#   cp .env.production.example .env.production
#
# .env.production is gitignored: the subdomain is account-specific.
VITE_API_BASE=https://unstable-dragons.YOUR-SUBDOMAIN.workers.dev
